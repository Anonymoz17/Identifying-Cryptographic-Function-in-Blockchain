{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Static detection results",
  "type": "object",
  "properties": {
    "file_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schema_version": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence_sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": { "type": "object" },
          "hints_path": { "type": "string" }
        },
        "required": ["id", "type", "score"],
        "additionalProperties": true
      }
    },
    "meta": { "type": "object" }
  },
  "required": ["file_hash", "schema_version", "timestamp", "findings"],
  "additionalProperties": true
}
