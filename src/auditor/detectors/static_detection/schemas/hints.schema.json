{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Static detection hints",
  "type": "object",
  "properties": {
    "file_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schema_version": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "language": { "type": "string" },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "address_or_range": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "start": { "type": "string" },
                  "end": { "type": "string" }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              }
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason_tags": { "type": "array", "items": { "type": "string" } },
          "evidence_snippet": { "type": "string" },
          "call_graph_neighbors": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "type", "confidence"],
        "additionalProperties": true
      }
    }
  },
  "required": ["file_hash", "schema_version", "timestamp", "hints"],
  "additionalProperties": true
}
