{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cryptoscope.dev/schemas/dynamic_config.schema.json",
  "title": "Dynamic Analysis Configuration",
  "description": "Schema for per-binary dynamic analysis configuration",
  "type": "object",
  "properties": {
    "args": {
      "type": "array",
      "description": "Command-line arguments for binary (spawn mode)",
      "items": {
        "type": "string"
      },
      "examples": [
        ["--verbose", "--config=config.ini"],
        ["-d", "/tmp/data"]
      ]
    },
    "input_file": {
      "type": "string",
      "description": "Path to input file for binary to read",
      "examples": [
        "test_input.dat",
        "config.json"
      ]
    },
    "timeout": {
      "type": "integer",
      "description": "Timeout in seconds (overrides default)",
      "minimum": 10,
      "maximum": 3600,
      "default": 500
    },
    "memory_limit": {
      "type": "integer",
      "description": "Memory limit in MB (overrides default)",
      "minimum": 128,
      "maximum": 4096,
      "default": 512
    },
    "instrumenters": {
      "type": "object",
      "description": "Which instrumenters to enable",
      "properties": {
        "crypto_ops": {
          "type": "boolean",
          "description": "Hook crypto API calls",
          "default": true
        },
        "memory_scan": {
          "type": "boolean",
          "description": "Scan for high-entropy memory",
          "default": false
        },
        "call_graph": {
          "type": "boolean",
          "description": "Build call graph",
          "default": false
        }
      },
      "default": {
        "crypto_ops": true,
        "memory_scan": false,
        "call_graph": false
      }
    },
    "crypto_apis": {
      "type": "object",
      "description": "Additional crypto APIs to hook",
      "properties": {
        "custom_modules": {
          "type": "array",
          "description": "Custom DLL/module names to hook",
          "items": {
            "type": "string"
          },
          "examples": [
            ["custom_crypto.dll", "libcrypto.dll"]
          ]
        },
        "custom_functions": {
          "type": "array",
          "description": "Custom function names to hook",
          "items": {
            "type": "string"
          },
          "examples": [
            ["my_encrypt", "my_decrypt"]
          ]
        }
      }
    },
    "entropy_threshold": {
      "type": "number",
      "description": "Entropy threshold for memory scanning (bits/byte)",
      "minimum": 0.0,
      "maximum": 8.0,
      "default": 7.5
    },
    "max_trace_events": {
      "type": "integer",
      "description": "Maximum trace events to collect",
      "minimum": 100,
      "maximum": 100000,
      "default": 10000
    },
    "max_crypto_calls": {
      "type": "integer",
      "description": "Maximum crypto calls to capture",
      "minimum": 10,
      "maximum": 1000,
      "default": 100
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about this configuration"
    }
  }
}
