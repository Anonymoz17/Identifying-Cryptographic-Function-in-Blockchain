{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cryptoscope.dev/schemas/trace_event.schema.json",
  "title": "Trace Event",
  "description": "Schema for individual trace events in NDJSON format",
  "type": "object",
  "required": ["type", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "description": "Event type",
      "enum": ["crypto_call", "crypto_return", "memory_scan", "call_graph", "error"]
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp in milliseconds"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "crypto_call"}}
      },
      "then": {
        "required": ["hint_id", "function", "module"],
        "properties": {
          "hint_id": {
            "type": ["string", "null"],
            "description": "Related hint ID from static analysis"
          },
          "function": {
            "type": "string",
            "description": "Crypto function name"
          },
          "module": {
            "type": "string",
            "description": "Module/DLL name (e.g., bcrypt.dll)"
          },
          "address": {
            "type": "string",
            "description": "Function address (hex)",
            "pattern": "^0x[0-9a-f]+$"
          },
          "args_hashes": {
            "type": "object",
            "description": "Hashes of function arguments (no raw data)",
            "additionalProperties": {
              "type": "string"
            }
          },
          "backtrace": {
            "type": "array",
            "description": "Call backtrace",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "crypto_return"}}
      },
      "then": {
        "required": ["function"],
        "properties": {
          "function": {
            "type": "string",
            "description": "Function name"
          },
          "retval": {
            "type": ["integer", "string"],
            "description": "Return value or hash"
          },
          "retval_hash": {
            "type": "string",
            "description": "Hash of return value if buffer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "memory_scan"}}
      },
      "then": {
        "required": ["range", "entropy", "hash"],
        "properties": {
          "range": {
            "type": "string",
            "description": "Memory range (e.g., 0x1000-0x2000)"
          },
          "entropy": {
            "type": "number",
            "description": "Entropy value (bits/byte)",
            "minimum": 0,
            "maximum": 8
          },
          "hash": {
            "type": "string",
            "description": "SHA256 hash of memory region"
          },
          "size": {
            "type": "integer",
            "description": "Size of region in bytes",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "call_graph"}}
      },
      "then": {
        "required": ["caller", "callee"],
        "properties": {
          "caller": {
            "type": "string",
            "description": "Caller address (hex)",
            "pattern": "^0x[0-9a-f]+$"
          },
          "callee": {
            "type": "string",
            "description": "Callee address (hex)",
            "pattern": "^0x[0-9a-f]+$"
          },
          "caller_symbol": {
            "type": "string",
            "description": "Caller symbol name (if resolved)"
          },
          "callee_symbol": {
            "type": "string",
            "description": "Callee symbol name (if resolved)"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "error"}}
      },
      "then": {
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "source": {
            "type": "string",
            "description": "Error source (script, harness, etc.)"
          }
        }
      }
    }
  ]
}
