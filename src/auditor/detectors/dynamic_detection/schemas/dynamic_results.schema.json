{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cryptoscope.dev/schemas/dynamic_results.schema.json",
  "title": "Dynamic Analysis Results",
  "description": "Schema for dynamic analysis results from Frida instrumentation",
  "type": "object",
  "required": ["file_hash", "schema_version", "timestamp", "mode", "summary", "findings", "trace_summary", "meta"],
  "properties": {
    "file_hash": {
      "type": "string",
      "description": "SHA256 hash of analyzed binary",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "type": "string",
      "description": "Schema version for compatibility",
      "pattern": "^\\d+\\.\\d+$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of analysis",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "description": "Execution mode",
      "enum": ["spawn", "attach"]
    },
    "incomplete": {
      "type": "boolean",
      "description": "Whether run was incomplete (timeout/crash)",
      "default": false
    },
    "incomplete_reason": {
      "type": ["string", "null"],
      "description": "Reason for incomplete run",
      "enum": ["timeout", "crash", "memory_limit", "error", null]
    },
    "summary": {
      "type": "object",
      "description": "High-level summary of findings",
      "required": ["total_crypto_calls", "unique_functions", "execution_time_seconds"],
      "properties": {
        "total_crypto_calls": {
          "type": "integer",
          "description": "Total number of crypto API calls observed",
          "minimum": 0
        },
        "unique_functions": {
          "type": "array",
          "description": "List of unique crypto functions called",
          "items": {
            "type": "string"
          }
        },
        "high_entropy_regions": {
          "type": "integer",
          "description": "Number of high-entropy memory regions found",
          "minimum": 0
        },
        "call_graph_nodes": {
          "type": "integer",
          "description": "Number of nodes in call graph",
          "minimum": 0
        },
        "execution_time_seconds": {
          "type": "number",
          "description": "Actual execution time in seconds",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "List of crypto-related findings",
      "items": {
        "type": "object",
        "required": ["id", "type", "confidence"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique finding identifier"
          },
          "type": {
            "type": "string",
            "description": "Type of finding",
            "enum": ["crypto_call", "high_entropy_memory", "call_pattern"]
          },
          "function": {
            "type": "string",
            "description": "Function name (for crypto_call type)"
          },
          "module": {
            "type": "string",
            "description": "Module/DLL name"
          },
          "count": {
            "type": "integer",
            "description": "Number of times observed",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "description": "Confidence score (0.0-1.0)",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "evidence": {
            "type": "string",
            "description": "Brief evidence description"
          },
          "hint_id": {
            "type": ["string", "null"],
            "description": "Related hint ID from static analysis"
          }
        }
      }
    },
    "trace_summary": {
      "type": "object",
      "description": "Summary of trace collection",
      "required": ["total_events", "size_bytes", "limits_reached"],
      "properties": {
        "total_events": {
          "type": "integer",
          "description": "Total number of trace events",
          "minimum": 0
        },
        "crypto_calls": {
          "type": "integer",
          "description": "Number of crypto call events",
          "minimum": 0
        },
        "memory_scans": {
          "type": "integer",
          "description": "Number of memory scan events",
          "minimum": 0
        },
        "call_graph_edges": {
          "type": "integer",
          "description": "Number of call graph edges",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "description": "Total trace size in bytes",
          "minimum": 0
        },
        "limits_reached": {
          "type": "object",
          "description": "Which limits were reached",
          "properties": {
            "max_events": {
              "type": "boolean",
              "description": "Whether max events limit was reached"
            },
            "max_crypto_calls": {
              "type": "boolean",
              "description": "Whether max crypto calls limit was reached"
            },
            "max_size": {
              "type": "boolean",
              "description": "Whether max size limit was reached"
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Metadata about the analysis",
      "required": ["tool_versions"],
      "properties": {
        "tool_versions": {
          "type": "object",
          "description": "Tool versions used",
          "required": ["frida", "python", "detector_version"],
          "properties": {
            "frida": {
              "type": "string",
              "description": "Frida version"
            },
            "python": {
              "type": "string",
              "description": "Python version"
            },
            "detector_version": {
              "type": "string",
              "description": "Dynamic detector version"
            },
            "platform": {
              "type": "string",
              "description": "Platform (Windows, Linux, etc.)"
            }
          }
        },
        "config": {
          "type": "object",
          "description": "Configuration used for analysis",
          "properties": {
            "timeout": {
              "type": "integer",
              "description": "Timeout in seconds"
            },
            "memory_limit": {
              "type": "integer",
              "description": "Memory limit in MB"
            },
            "instrumenters": {
              "type": "object",
              "description": "Which instrumenters were enabled"
            }
          }
        }
      }
    }
  }
}
